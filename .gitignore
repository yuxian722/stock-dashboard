__pycache__/
*.pyc

# 真實帳密/session設定檔，不進版控（用 config.txt.example 當範本）
da_bot/config.txt
da_bot/cpis_credentials.txt
da_bot/teamplus_cookie.txt

# SQLite 資料庫（含測試/正式資料，也涵蓋tests/底下手動測試時意外產生的檔案）
da_bot/**/*.db
da_bot/**/*.db-journal
da_bot/**/*.db-wal
da_bot/**/*.db-shm

# 執行期產生的狀態/紀錄檔
da_bot/listener_state.txt
da_bot/push_log.txt
da_bot/last_pipeline_hour.txt
da_bot/teamplus_listener.lock
da_bot/sent_batch_ids.log

# Selenium附身模式殘留物（CPIS/health_dashboard已不需要，其餘手動除錯工具本機自備即可）
